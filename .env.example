# =====================================================================
# Trading Agent TIO — contoh konfigurasi.
# Salin ke .env lalu isi. WAJIB: chmod 600 .env
# =====================================================================

# --- Umum ---
TIMEZONE=Asia/Jakarta
LOG_LEVEL=INFO
DATA_DIR=./data                 # DB & artefak JSON disimpan di sini
DRY_RUN=false                   # true = jangan kirim email/telegram sungguhan

# --- Watchlist awal (opsional; ticker IDX tanpa .JK, dipisah koma) ---
WATCHLIST=BBCA,BBRI,TLKM,ASII,ANTM

# --- Sumber data pasar ---
# provider:
#   yahoo_relay  (REKOMENDASI: data Yahoo penuh & gratis lewat relay Cloudflare
#                 Worker milik Anda — sidestep blokir IP VPS. Setup 3 menit,
#                 lihat scripts/cloudflare-worker.js)
#   fmp          (Financial Modeling Prep; gratis dengan API key; dukung .JK?)
#   alphavantage (gratis dgn API key; kuota kecil ~25/hari; sufiks .JKT)
#   twelvedata   (free TIDAK mencakup IDX — butuh plan Pro berbayar)
#   stooq        (gratis tanpa key; TIDAK mencakup IDX)
#   yahoo_direct / yfinance  (DIBLOKIR 429 di IP data-center Tencent)
#   goapi | rti  (berbayar, realtime — belum diimplementasikan)
# TIP: jalankan `python scripts/diag_data.py` di VPS untuk lihat mana yang tembus.
MARKET_DATA_PROVIDER=yahoo_relay

# --- Relay Cloudflare (untuk provider=yahoo_relay) ---
YAHOO_RELAY_URL=       # mis. https://yf-relay.<akun>.workers.dev
YAHOO_RELAY_TOKEN=     # samakan dgn RELAY_TOKEN di Worker (opsional tapi disarankan)

# --- API berbasis key (cadangan) ---
FMP_API_KEY=           # gratis: financialmodelingprep.com
ALPHAVANTAGE_KEY=      # gratis: https://www.alphavantage.co/support/#api-key
TWELVEDATA_KEY=        # catatan: free tier tidak mencakup IDX
GOAPI_KEY=
RTI_TOKEN=

# --- LLM (untuk narasi Agent 1/2/4 & vision Agent 6) ---
# provider: anthropic | openrouter | none  (none = lewati LLM, pakai template)
LLM_PROVIDER=anthropic

# Jika LLM_PROVIDER=anthropic (SDK resmi Anthropic):
LLM_MODEL=claude-haiku-4-5-20251001
LLM_VISION_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# Jika LLM_PROVIDER=openrouter (endpoint OpenAI-compatible, butuh: pip install openai):
#   - Isi OPENROUTER_API_KEY.
#   - Set LLM_MODEL=auto agar sistem MEMILIH SENDIRI model GRATIS yang tersedia
#     (memfilter harga nol; untuk vision, yang mendukung gambar). Lihat pilihannya:
#       python -m src.cli llm-model
#   - Atau tetapkan manual, mis: LLM_MODEL=deepseek/deepseek-chat-v3.1:free
#     (nama harus format vendor/model sesuai daftar OpenRouter).
OPENROUTER_API_KEY=

# --- Telegram (Agent 5 & 6) ---
TELEGRAM_BOT_TOKEN=
# Hanya Chat ID ini yang boleh berinteraksi (keamanan). Pisah koma jika >1.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Email (Agent 4) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                  # gunakan App Password, bukan password akun
EMAIL_FROM=
EMAIL_TO=tio158@gmail.com

# --- Parameter strategi (Agent 3) ---
ATR_PERIOD=14
MIN_RRR=2.0                     # minimal risk-to-reward ratio
MAX_STOPLOSS_PCT=3.0            # cut loss maksimal (%) dari entry
VOLUME_SPIKE_MULTIPLIER=2.0     # volume > x rata-rata 20 hari = "spike"
VOLUME_LOOKBACK_DAYS=20
MAX_CANDIDATES=5                # shortlist maksimum dari Agent 2

# --- Jam bursa (WIB, format HH:MM) ---
SESSION1_OPEN=09:00
SESSION1_CLOSE=12:00
SESSION2_OPEN=13:30
SESSION2_CLOSE=15:50
MONITOR_POLL_SECONDS=60         # interval polling Agent 5
